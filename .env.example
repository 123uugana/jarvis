# Copy this file to .env.local. Never commit real keys.
#
# ASHNA_API_KEY is server-only: Vite exposes only VITE_-prefixed values to the
# browser, and the bridge never sends this key in WebSocket frames or logs.

# Required. Create a key in https://app.ashna.ai under Account → API.
ASHNA_API_KEY=

# Optional Ashna foundation model or custom agent id.
# Default: gpt-4o-mini. Current ids: https://www.ashna.ai/api-docs
# ASHNA_MODEL=gpt-4o-mini

# Whole-request timeout and retained conversation messages per WebSocket session.
# ASHNA_TIMEOUT_MS=120000
# ASHNA_MAX_CONTEXT_MESSAGES=20

# Bridge WebSocket + HTTP port. Keep VITE_BRIDGE_URL in step if changed.
# JARVIS_BRIDGE_PORT=8787

# Windows apps, volume/media and effectful browser tools are disabled by default.
# JARVIS_ALLOW_WRITES=0
# Full Windows PowerShell + screenshots + mouse/keyboard (also enables writes).
# Commands run with your Windows account permissions; screenshots go to AshnaAI.
# JARVIS_ALLOW_COMPUTER=0
# Optional path when Chrome is not installed in its usual location.
# JARVIS_CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# Ctrl+Alt+J works while the Windows bridge is running. Set 0 to disable.
# JARVIS_GLOBAL_HOTKEY=1

# Extra browser origins, comma separated. Local Vite dev ports are allowed.
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_ALLOW_NO_ORIGIN=0

# Extra roots allowed by the bridge's /file endpoint, comma separated.
# JARVIS_FILE_ROOTS=

# Optional ElevenLabs speech-to-text and text-to-speech.
# ELEVENLABS_API_KEY=
# JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Scribe fallback language; the Controls panel's saved language takes precedence.
# JARVIS_STT_LANGUAGE=en

# Frontend settings. Never prefix ASHNA_API_KEY with VITE_.
# VITE_BRIDGE_URL=ws://localhost:8787
# VITE_TTS_ENGINE=system
# VITE_KOKORO_VOICE=bm_george
# VITE_USE_ELEVENLABS=false
# VITE_PICOVOICE_ACCESS_KEY=
# Initial browser defaults; settings saved in Controls take precedence.
# VITE_SPEECH_LANGUAGE=en-US
# VITE_SPEECH_PAUSE_MS=1100
